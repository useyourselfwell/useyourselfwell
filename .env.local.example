# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Brevo (Sendinblue)
BREVO_API_KEY=
BREVO_LIST_ID=2
BREVO_APPLY_LIST_ID=4
BREVO_WORKSHOP_LIST_ID=5
BREVO_FROM_EMAIL=hello@useyourselfwell.com
BREVO_FROM_NAME=Use Yourself Well

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@useyourselfwell.com

# Internal
CHRISTOPHER_EMAIL=christopher@useyourselfwell.com

# Cal.com
NEXT_PUBLIC_CAL_URL=https://cal.com/your-username/one-skill

# Site
NEXT_PUBLIC_SITE_URL=https://useyourselfwell.com

# Cloudflare Turnstile (bot protection on all public forms)
# Public site key — safe to expose to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key — server-side only. Never expose this to the client.
TURNSTILE_SECRET_KEY=
# Optional, comma-separated allowlist of frontend hostnames siteverify must
# match, e.g. useyourselfwell.com,www.useyourselfwell.com
# If unset, it falls back to those two production hostnames (localhost is
# additionally allowed outside production). Do not list localhost in production.
TURNSTILE_HOSTNAMES=
